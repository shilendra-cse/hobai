{
  "model": "gpt-6-luna",
  "input": [
    {
      "role": "developer",
      "content": "You are a coding agent working in a repository. Before each tool call, say in one short sentence what you are about to do."
    },
    {
      "role": "user",
      "content": [
        {
          "type": "input_text",
          "text": "Read README.md, then call finish_task with a one-sentence summary of what the repository is."
        }
      ]
    }
  ],
  "tools": [
    {
      "type": "function",
      "name": "read_file",
      "description": "Read a file from the repository.",
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": ["path"],
        "additionalProperties": false
      },
      "strict": false
    },
    {
      "type": "function",
      "name": "finish_task",
      "description": "Finish the task with a summary.",
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "summary": {
            "type": "string"
          }
        },
        "required": ["summary"],
        "additionalProperties": false
      },
      "strict": false
    }
  ],
  "tool_choice": "auto",
  "stream": true
}
